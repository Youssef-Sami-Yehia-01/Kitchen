{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/viewer.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/apartment(.*).js",
      "headers": [{"key":"Cache-Control","value":"no-cache"}]
    },
    {
      "source": "/assets/apartment(.*).json",
      "headers": [{"key":"Cache-Control","value":"no-cache"}]
    }
  ]
}
